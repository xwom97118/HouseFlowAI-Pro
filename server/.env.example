# HouseFlow License Server - environment variable reference (Phase 3A).
#
# This file lists every variable the server reads, with placeholder
# values only. It is safe to commit - copy it to `.env` for local use
# (and keep `.env` itself out of git; it already matches this repo's
# .gitignore) or set the real values directly in Render's dashboard
# for production. NEVER put a real secret value in this file.

# --- Core ---------------------------------------------------------

# "development" (default) or "production". Controls several
# fail-fast checks: in production, HOUSEFLOW_SECRET_KEY and
# HOUSEFLOW_LICENSE_SIGNING_PRIVATE_KEY become required (no auto-
# generated ephemeral fallback), and startup runs Alembic migrations
# instead of create_all().
ENVIRONMENT=development

# Database connection. Render auto-injects a variable literally named
# DATABASE_URL when you link its managed PostgreSQL to this service -
# HOUSEFLOW_LICENSE_DB_URL takes priority if you also set it (useful
# for local dev against a specific SQLite file, or to point at a
# database Render didn't provision). Leave both unset for local
# development - defaults to server/data/license_server.db (SQLite).
# HOUSEFLOW_LICENSE_DB_URL=postgresql+psycopg://user:password@host:5432/dbname
# DATABASE_URL is normally set FOR you by Render - do not set it here.

# --- Secrets (no defaults in production - the app refuses to start
# without them once ENVIRONMENT=production) -------------------------

# Used to derive CSRF tokens (server/app/csrf.py). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HOUSEFLOW_SECRET_KEY=replace-with-a-real-random-value-never-commit-this

# Ed25519 private key (PEM, base64-encoded) used to sign every
# license-state API response so the Desktop client can detect a
# tampered local cache (server/app/services/signing_service.py).
# Generate a fresh pair with: python server/generate_signing_keypair.py
# Only the PRIVATE key goes here. The matching PUBLIC key goes on the
# Desktop side as HOUSEFLOW_LICENSE_SERVER_PUBLIC_KEY - never put the
# private key anywhere Desktop-side.
HOUSEFLOW_LICENSE_SIGNING_PRIVATE_KEY=replace-with-base64-pem-private-key

# --- Admin bootstrap -------------------------------------------------
# There is no HOUSEFLOW_ADMIN_USERNAME / HOUSEFLOW_ADMIN_PASSWORD_HASH
# pair read automatically at startup - the first Admin account is
# created once, explicitly, by running:
#   python server/bootstrap_admin.py --username <name>
# (interactive password prompt), or non-interactively with:
#   HOUSEFLOW_ADMIN_BOOTSTRAP_PASSWORD=... python server/bootstrap_admin.py --username <name> --from-env
# This is safe to re-run on every deploy - it refuses to create a
# second account with the same username (see
# server/app/services/admin_auth_service.create_admin_user) and never
# resets an existing password.
# HOUSEFLOW_ADMIN_BOOTSTRAP_PASSWORD=only-set-this-transiently-when-bootstrapping

# --- Network / TLS ---------------------------------------------------

# "1" in production. Governs whether the Admin session cookie gets the
# Secure flag, and prints a startup warning when left at "0" (the
# default, for local HTTP development).
HOUSEFLOW_LICENSE_REQUIRE_HTTPS=0

# The public URL this service is served from (e.g.
# https://license.houseflow.example). Used for the CORS allow-list
# (server/app/main.py) - leave unset locally, no browser-based caller
# needs it.
APP_BASE_URL=

# --- Sessions / logging ----------------------------------------------

HOUSEFLOW_ADMIN_SESSION_TTL_HOURS=12
LOG_LEVEL=INFO

# --- Test-only flag (never set this in a real deployment) ------------
# Lets server/tests/_live_server.py start a real uvicorn instance
# without the startup handler touching the default dev database. See
# server/app/config.py for why this exists.
# HOUSEFLOW_LICENSE_SKIP_STARTUP_DB_INIT=1
